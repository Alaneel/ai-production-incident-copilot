{
  "name": "fault-lab",
  "metrics": {
    "request_latency_p95": {
      "promql": "histogram_quantile(0.95, sum by (le) (rate(incident_http_request_duration_seconds_bucket{service=\"{{service}}\"}[5m]))) * 1000",
      "unit": "milliseconds"
    },
    "request_error_rate": {
      "promql": "sum(rate(incident_http_requests_total{service=\"{{service}}\",status=\"error\"}[5m])) / clamp_min(sum(rate(incident_http_requests_total{service=\"{{service}}\"}[5m])), 0.000001)",
      "unit": "ratio"
    },
    "db_pool_active": {
      "promql": "incident_db_pool_active{service=\"{{service}}\"}",
      "unit": "connections"
    },
    "db_pool_active_ratio": {
      "promql": "incident_db_pool_active{service=\"{{service}}\"} / incident_db_pool_max{service=\"{{service}}\"}",
      "unit": "ratio"
    },
    "cpu_utilization": {
      "promql": "incident_fault_cpu_load{service=\"{{service}}\"}",
      "unit": "ratio"
    },
    "memory_working_set": {
      "promql": "incident_fault_memory_bytes{service=\"{{service}}\"}",
      "unit": "bytes"
    },
    "kafka_consumer_lag": {
      "promql": "incident_kafka_consumer_lag{service=\"{{service}}\"}",
      "unit": "messages"
    },
    "retry_rate": {
      "promql": "incident_retry_rate{service=\"{{service}}\"}",
      "unit": "retries_per_second"
    },
    "cache_miss_rate": {
      "promql": "incident_cache_miss_rate{service=\"{{service}}\"}",
      "unit": "misses_per_second"
    }
  },
  "log_selector": "{service=\"{{service}}\"}",
  "trace_service_attribute": "resource.service.name"
}
