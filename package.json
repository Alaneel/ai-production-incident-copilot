{
  "name": "ai-production-incident-copilot-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --local --ip 127.0.0.1 --port ${OPSPILOT_CONSOLE_PORT:-3000} --inspector-ip 127.0.0.1 --inspector-port 0 --config dist/server/wrangler.json --env-file /dev/null --show-interactive-dev-session=false",
    "test": "npm run typecheck && npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "test:stream-contract": "node --experimental-strip-types --test tests/backend-stream-contract.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "types:generate": "WRANGLER_LOG_PATH=.wrangler/types.log wrangler types worker/runtime.d.ts --include-env false --env-file /dev/null --config worker/types.wrangler.json",
    "db:generate": "drizzle-kit generate",
    "build:public": "OPSPILOT_PUBLIC_BUILD=1 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.1.0",
    "vite": "8.3.4",
    "wrangler": "4.150.0",
    "miniflare": "5.20261006.2-beta"
  },
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.9",
  "overrides": {
    "@babel/core": "7.29.6",
    "postcss": "8.5.30",
    "source-map-js": "1.2.2",
    "image-size": "2.0.4",
    "nanoid@^3.0.0": "3.3.18",
    "fast-uri@^3.0.0": "3.1.8",
    "brace-expansion@^1.0.0": "1.1.21",
    "brace-expansion@^2.0.0": "2.1.7",
    "brace-expansion@^3.0.0": "3.0.9",
    "brace-expansion@^5.0.0": "5.0.12",
    "ws": "8.22.0",
    "fflate": "0.8.3",
    "esbuild": "0.28.2",
    "sharp": "0.35.5"
  }
}
